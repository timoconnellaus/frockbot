{
  "name": "@frockbot/desktop",
  "version": "0.0.1",
  "description": "FrockBot desktop app for persistent conversational bots",
  "author": "Tim O'Connell",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "build:webui": "bun run --filter @frockbot/plugin-shell build && bun run --filter @frockbot/plugin-clock build && bun run --filter @frockbot/plugin-computer build",
    "build:agent": "bun run --filter @frockbot/agent-runtime build",
    "dev": "bun run build:webui && electron-vite dev",
    "build": "bun run build:webui && electron-vite build",
    "package": "bun run build:agent && bun run build && electron-builder",
    "package:dir": "bun run build:agent && bun run build && electron-builder --dir",
    "start": "bun run build:webui && electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@better-auth/electron": "1.7.2",
    "@cordisjs/client": "0.8.2",
    "@cordisjs/plugin-loader": "1.0.0-rc.5",
    "@cordisjs/plugin-server": "1.7.0",
    "@cordisjs/plugin-webui": "0.8.2",
    "@frockbot/application-foundation": "workspace:*",
    "@frockbot/desktop-core": "workspace:*",
    "@frockbot/plugin-shell": "workspace:*",
    "@frockbot/protocol": "workspace:*",
    "better-auth": "1.7.2",
    "conf": "15.1.0",
    "cordis": "4.0.0-rc.8"
  },
  "build": {
    "appId": "com.frockbot.desktop",
    "productName": "FrockBot",
    "asar": true,
    "directories": {
      "buildResources": "resources",
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/cordis-agent",
        "to": "cordis-agent",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "icon": "resources/icon.icns",
      "target": "dmg"
    },
    "win": {
      "icon": "resources/icon.ico",
      "target": "nsis"
    },
    "linux": {
      "icon": "resources/icons",
      "target": "AppImage",
      "category": "Utility"
    }
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^26.2.0",
    "electron": "^44.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "8.2.2"
  }
}
