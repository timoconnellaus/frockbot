{
  // The Worker half. The container half is typechecked separately against
  // Node's globals: one program cannot hold both `@cloudflare/workers-types`
  // and `@types/node`, and this app is genuinely two runtimes.
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2023", "WebWorker"],
    "types": ["bun", "@cloudflare/workers-types"]
  },
  "include": ["src/**/*.ts"]
}
