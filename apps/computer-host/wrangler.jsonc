{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "frockbot-computer-host",
  "account_id": "374784ce2915a597adcecf9bcb2c5ee6",
  "workers_dev": false,
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  // No routes, by design. The shared Computer host (ADR 0004) is reachable
  // only through the app Worker's COMPUTER_HOST service binding, and the
  // container re-checks a shared token on top of that.
  // The container class keeps the prototype's `FlyHostContainer` name. A
  // Cloudflare container application is bound to one Durable Object class for
  // its lifetime, so renaming the class asks for a second application on the
  // same script and the deploy fails with
  // `DURABLE_OBJECT_ALREADY_HAS_APPLICATION`. Taking a new name would mean
  // deleting the live application first, dropping the running containers.
  "containers": [
    {
      "class_name": "FlyHostContainer",
      "image": "./Dockerfile",
      // The image needs the two workspace packages the container imports, so
      // the build context is the repository root; the root `.dockerignore`
      // keeps everything else out of it.
      "image_build_context": "../..",
      "instance_type": "basic",
      "max_instances": 3,
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "COMPUTER_HOST_CONTAINER",
        "class_name": "FlyHostContainer",
      },
      // The superseded single-effect seam addressed the same containers under
      // this name. Kept so live ComputerEffectJournal objects keep resolving.
      {
        "name": "FLY_HOST",
        "class_name": "FlyHostContainer",
      },
      {
        "name": "COMPUTER_EFFECTS",
        "class_name": "ComputerEffectJournal",
      },
    ],
  },
  // Exactly the prototype's migrations, already applied to this script. The
  // supersession renames no durable class and creates none, so the list must
  // not grow: a rename migration here is what tried to create a second
  // container application and broke the deploy.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["FlyHostContainer"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ComputerEffectJournal"],
    },
  ],
  "vars": {
    // Two warm shards. A User is routed by userId, so every Bot of one User
    // reaches the one container that holds its Computer's locks.
    "COMPUTER_HOST_SHARDS": "2",
    // The superseded seam's own shard count, unchanged.
    "FLY_HOST_SHARDS": "1",
  },
  "observability": {
    "enabled": true,
  },
}
