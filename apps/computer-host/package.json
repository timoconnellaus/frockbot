{
  "name": "@frockbot/computer-host",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "knip": {
    "entry": [
      "src/index.ts",
      "container/server.ts",
      "live-test.ts",
      "src/**/*.test.ts",
      "container/**/*.test.ts"
    ],
    "project": [
      "src/**/*.ts",
      "container/**/*.ts",
      "live-test.ts"
    ]
  },
  "scripts": {
    "build": "wrangler deploy --dry-run --env=\"\" --outdir dist",
    "container:start": "node container/server.ts",
    "dev": "wrangler dev --port 8790",
    "test": "bun test src container",
    "test:workerd": "vitest run --config vitest.config.ts",
    "test:live": "bun run live-test.ts",
    "test:live:desktop": "bun run live-desktop-lease.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p container/tsconfig.json"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "@fly/sprites": "0.1.0",
    "@frockbot/computer-core": "workspace:*",
    "@frockbot/computer-host-protocol": "workspace:*",
    "@frockbot/computer-host-runtime": "workspace:*",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.1",
    "@cloudflare/workers-types": "latest",
    "@types/bun": "1.4.0",
    "@types/node": "26.4.0",
    "@types/ws": "8.18.1",
    "typescript": "7.0.2",
    "vitest": "^4.1.0",
    "wrangler": "latest"
  }
}
