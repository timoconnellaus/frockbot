{
  "name": "@frockbot/cloudflare",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "client:build": "vite build",
    "client:dev": "vite",
    "artifact:build": "bun run client:build && bun run build-artifact.ts",
    "build": "bun run artifact:build && wrangler deploy --dry-run --env=\"\" --outdir dist/gateway",
    "dev": "bun run artifact:build && wrangler dev --env development --var ALLOW_DEVELOPMENT_AUTH:true",
    "dev:electron": "bun run dev-electron.ts",
    "test": "bun test src && bun run test:workerd",
    "test:workerd": "vitest run --config vitest.config.ts",
    "test:integration": "bun run artifact:build && vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json && vue-tsc --noEmit -p tsconfig.client.json"
  },
  "dependencies": {
    "@better-auth/electron": "1.7.2",
    "@frockbot/agent-runtime": "workspace:*",
    "@frockbot/application-foundation": "workspace:*",
    "@frockbot/catalog-core": "workspace:*",
    "@frockbot/client-core": "workspace:*",
    "@frockbot/computer-core": "workspace:*",
    "@frockbot/configuration-core": "workspace:*",
    "@frockbot/connection-core": "workspace:*",
    "@frockbot/kernel-composition": "workspace:*",
    "@frockbot/kernel-contracts": "workspace:*",
    "@frockbot/kernel-do": "workspace:*",
    "@frockbot/mobile": "workspace:*",
    "@frockbot/plugin-authoring": "workspace:*",
    "@frockbot/plugin-credentials": "workspace:*",
    "@frockbot/plugin-flock": "workspace:*",
    "@frockbot/plugin-memory": "workspace:*",
    "@frockbot/plugin-package-publisher": "workspace:*",
    "@frockbot/plugin-provider-ollama-cloud": "workspace:*",
    "@frockbot/plugin-routines": "workspace:*",
    "@frockbot/plugin-search": "workspace:*",
    "@frockbot/plugin-settings": "workspace:*",
    "@frockbot/plugin-shell": "workspace:*",
    "@frockbot/workspace-store": "workspace:*",
    "better-auth": "1.7.2",
    "cordis": "4.0.0-rc.8",
    "vue": "3.5.41"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.1",
    "@cloudflare/workers-types": "latest",
    "@frockbot/computer-host-protocol": "workspace:*",
    "@frockbot/plugin-fly-sprite": "workspace:*",
    "@types/bun": "1.4.0",
    "@vitejs/plugin-vue": "6.0.8",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "^4.1.0",
    "vue-tsc": "3.3.10",
    "wrangler": "latest"
  }
}
