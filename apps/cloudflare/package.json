{
  "name": "@frockbot/cloudflare",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "client:build": "bun run build-flutter-web.ts",
    "artifact:build": "bun run client:build && bun run build-artifact.ts",
    "build": "bun run artifact:build && wrangler deploy --dry-run --env=\"\" --outdir dist/gateway",
    "dev": "bun run dev.ts",
    "test": "bun test src && bun run test:workerd",
    "test:workerd": "vitest run --config vitest.config.ts",
    "test:integration": "bun run artifact:build && vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json && tsc --noEmit -p e2e/tsconfig.json"
  },
  "dependencies": {
    "@cloudflare/voice": "0.4.0",
    "@cloudflare/voice-elevenlabs": "0.1.0",
    "@frockbot/app": "workspace:*",
    "@frockbot/applets": "workspace:*",
    "@frockbot/frock-compose": "workspace:*",
    "@frockbot/computer": "workspace:*",
    "@frockbot/core": "workspace:*",
    "@frockbot/providers": "workspace:*",
    "agents": "0.22.0",
    "ai": "^7.0.0",
    "better-auth": "1.7.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.1",
    "@cloudflare/workers-types": "5.20260907.1",
    "@playwright/test": "1.62.1",
    "@types/bun": "1.4.0",
    "typescript": "npm:typescript-native-bridge@6.0.3-bridge.16.tsgo.7.0.2",
    "vitest": "^4.1.0",
    "wrangler": "4.129.0"
  }
}
