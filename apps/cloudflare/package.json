{
  "name": "@frockbot/cloudflare",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "client:build": "vite build",
    "client:dev": "vite",
    "artifact:build": "bun run client:build && bun run build-artifact.ts",
    "build": "bun run artifact:build && wrangler deploy --dry-run --env=\"\" --outdir dist/gateway",
    "dev": "bun run dev.ts",
    "test": "bun test src && bun run test:workerd",
    "test:workerd": "vitest run --config vitest.config.ts",
    "test:integration": "bun run artifact:build && vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json && tsc --noEmit -p e2e/tsconfig.json && vue-tsc --noEmit -p tsconfig.client.json"
  },
  "dependencies": {
    "@frockbot/agent-runtime": "workspace:*",
    "@frockbot/application-foundation": "workspace:*",
    "@frockbot/client-core": "workspace:*",
    "@frockbot/compose-frockbot": "workspace:*",
    "@frockbot/computer-core": "workspace:*",
    "@frockbot/configuration-core": "workspace:*",
    "@frockbot/connection-core": "workspace:*",
    "@frockbot/kernel-contracts": "workspace:*",
    "@frockbot/kernel-do": "workspace:*",
    "@frockbot/machine-protocol": "workspace:*",
    "@frockbot/plugin-admin": "workspace:*",
    "@frockbot/plugin-applets": "workspace:*",
    "@frockbot/plugin-audit": "workspace:*",
    "@frockbot/plugin-bot-template": "workspace:*",
    "@frockbot/plugin-computer": "workspace:*",
    "@frockbot/plugin-credentials": "workspace:*",
    "@frockbot/plugin-flock": "workspace:*",
    "@frockbot/plugin-image": "workspace:*",
    "@frockbot/plugin-memory": "workspace:*",
    "@frockbot/plugin-provider-frock-ai": "workspace:*",
    "@frockbot/plugin-provider-ollama-cloud": "workspace:*",
    "@frockbot/plugin-routines": "workspace:*",
    "@frockbot/plugin-search": "workspace:*",
    "@frockbot/plugin-settings": "workspace:*",
    "@frockbot/plugin-shell": "workspace:*",
    "@frockbot/plugin-skills": "workspace:*",
    "@frockbot/plugin-subagents": "workspace:*",
    "@frockbot/plugin-tools": "workspace:*",
    "@frockbot/plugin-user-machine": "workspace:*",
    "@frockbot/protocol": "workspace:*",
    "@frockbot/template-core": "workspace:*",
    "@frockbot/workspace-store": "workspace:*",
    "better-auth": "1.7.2",
    "vue": "3.5.41",
    "@frockbot/protocol-schemas": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.1",
    "@cloudflare/workers-types": "latest",
    "@frockbot/computer-host-protocol": "workspace:*",
    "@frockbot/plugin-fly-sprite": "workspace:*",
    "@playwright/test": "1.62.1",
    "@types/bun": "1.4.0",
    "@vitejs/plugin-vue": "6.0.8",
    "typescript": "npm:typescript-native-bridge@6.0.3-bridge.16.tsgo.7.0.2",
    "vite": "8.2.2",
    "vitest": "^4.1.0",
    "vue-tsc": "3.3.10",
    "wrangler": "latest"
  }
}
