{
  "name": "@frockbot/cloudflare",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "client:build": "vite build",
    "client:dev": "vite",
    "artifact:build": "bun run client:build && bun run build-artifact.ts",
    "build": "bun run artifact:build && wrangler deploy --dry-run --env=\"\" --outdir dist/gateway",
    "dev": "bun run artifact:build && wrangler dev --env development --var ALLOW_DEVELOPMENT_AUTH:true",
    "dev:electron": "bun run dev-electron.ts",
    "test": "bun test src",
    "typecheck": "tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p tsconfig.client.json"
  },
  "dependencies": {
    "@better-auth/electron": "1.7.2",
    "@frockbot/agent-core": "workspace:*",
    "@frockbot/agent-runtime": "workspace:*",
    "@frockbot/application-foundation": "workspace:*",
    "@frockbot/client-core": "workspace:*",
    "@frockbot/configuration-core": "workspace:*",
    "@frockbot/plugin-composio": "workspace:*",
    "@frockbot/plugin-memory": "workspace:*",
    "@frockbot/plugin-shell": "workspace:*",
    "better-auth": "1.7.2",
    "cordis": "4.0.0-rc.8",
    "vue": "3.5.41"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/bun": "1.4.0",
    "@vitejs/plugin-vue": "6.0.8",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vue-tsc": "3.3.10",
    "wrangler": "latest"
  }
}
