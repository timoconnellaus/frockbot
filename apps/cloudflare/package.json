{
  "name": "@frockbot/cloudflare",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#auth-package": "./src/auth-package.ts"
  },
  "exports": {
    ".": "./src/worker-app.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timoconnellaus/frockbot.git",
    "directory": "apps/cloudflare"
  },
  "frockbot": {
    "npm": true
  },
  "scripts": {
    "client:build": "bun run build-flutter-web.ts",
    "artifact:build": "bun run client:build && bun run build-artifact.ts",
    "build": "bun run artifact:build && bun ../../scripts/deployment-config.ts hosted && wrangler deploy --dry-run -c ../../.deployment/hosted/app/wrangler.jsonc --outdir dist/gateway",
    "dev": "bun run dev.ts",
    "test": "bun test src && bun run test:workerd",
    "test:workerd": "vitest run --config vitest.config.ts",
    "test:integration": "bun run artifact:build && vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.access.json && tsc --noEmit -p test/tsconfig.json && tsc --noEmit -p e2e/tsconfig.json"
  },
  "dependencies": {
    "@frockbot/app": "workspace:*",
    "@frockbot/applets": "workspace:*",
    "@frockbot/frock-compose": "workspace:*",
    "@frockbot/computer": "workspace:*",
    "@frockbot/core": "workspace:*",
    "@frockbot/providers": "workspace:*",
    "agents": "0.23.0",
    "ai": "^7.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.4",
    "@cloudflare/workers-types": "5.20260907.1",
    "@playwright/test": "1.63.0",
    "@rive-app/flutter-native-wasm": "44.0.0",
    "@types/bun": "1.4.1",
    "typescript": "npm:typescript-native-bridge@6.0.3-bridge.16.tsgo.7.0.2",
    "vitest": "^4.1.0",
    "wrangler": "4.129.0"
  }
}
