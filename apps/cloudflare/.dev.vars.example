# Copy to .dev.vars and replace every value before testing hosted integrations.
BETTER_AUTH_URL=http://127.0.0.1:8787
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
GOOGLE_CLIENT_ID=replace-with-google-web-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-web-client-secret
SPRITES_TOKEN=replace-with-fly-sprites-token
# The shared secret the app Worker presents to the Computer host Worker and the
# host's container re-checks. It must match the host's own COMPUTER_HOST_TOKEN.
COMPUTER_HOST_TOKEN=replace-with-shared-computer-host-token
CREDENTIAL_KEYRING={"schemaVersion":1,"currentKeyId":"development","keys":{"development":"replace-with-base64url-encoded-32-byte-key"}}
ALLOW_DEVELOPMENT_AUTH=true
# Authorizes the read-only operator surface at /api/debug/*. Absent or empty
# and those routes 404. Deployed as a Wrangler secret, never a var.
DEBUG_TOKEN=replace-with-a-random-32-byte-token
# `cf-aig-authorization` bearer for the AI Gateway named by FROCK_AI_GATEWAY_ID.
# Set together with the FROCK_AI_ACCOUNT_ID var, this selects the compat HTTP
# transport, the only one that accepts the `dynamic/<route>` Auto model
# (cloudflare/ai#617). Absent, Frock AI falls back to the `AI` binding, which
# serves concrete `@frock/...` models but rejects Auto.
FROCK_AI_GATEWAY_TOKEN=replace-with-ai-gateway-authorization-token
# The pre-rename name `FLOCK_AI_GATEWAY_TOKEN` is still read as a fallback, so
# an existing local .dev.vars keeps working until it is renamed.
# Voice (docs/voice.md). Both are required in production; absent locally, the
# microphone and waveform buttons answer that voice is not set up.
# The composer's dictation opens `wss://api.openai.com/v1/realtime` with this
# key from the Worker (`gpt-live-transcribe`). The client never sees it.
# Absent, dictation says voice is not set up.
OPENAI_API_KEY=replace-with-an-openai-api-key
# The continuous voice session: one Gemini Live socket per call, which hears,
# thinks and speaks. The key goes on the upstream URL from the Worker and
# never leaves it. Absent, starting a call says voice is not set up.
GEMINI_API_KEY=replace-with-a-google-ai-studio-api-key
# Optional: a gateway model for the end-of-call memory update instead of the
# platform's Auto route. The call itself has no chat model.
# VOICE_ASSISTANT_MODEL=workers-ai/@cf/meta/llama-3.3-70b-instruct-fp8-fast
# Optional: the model that tidies a dictated transcript once the raw text
# has landed, instead of Groq's 8B instant class. No `AI` binding means no
# tidying and the raw transcript stands.
# VOICE_DICTATION_CLEANUP_MODEL=groq/llama-3.1-8b-instant
# Reviews a Groq tidy before it replaces the draft. The same key is Turn
# supervision and the routine-event rejector. Absent or a failed call keeps
# the raw transcript.
# JEV_API_KEY=replace-with-jev-api-key

# Connected apps: the provider project key. Absent, no app can be connected
# and the Connectors rows for apps say so.
COMPOSIO_API_KEY=replace-with-composio-project-api-key

# Billing: use Stripe TEST mode locally. Never commit live values.
# STRIPE_SECRET_KEY is the switch: leave it unset and billing stays off.
# A localhost BETTER_AUTH_URL never bills, even with a key.
# Configure webhook API version 2025-02-24.acacia.
STRIPE_SECRET_KEY=replace-with-stripe-test-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-stripe-test-webhook-secret
STRIPE_MONTHLY_PRICE_ID=replace-with-20-usd-monthly-price-id
# Hosted model prices are the deployment's rate table, edited in the admin
# portal, not a variable. See docs/billing.md.
