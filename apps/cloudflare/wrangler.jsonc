{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "frockbot-cloudflare",
  "account_id": "374784ce2915a597adcecf9bcb2c5ee6",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "bot.frockbot.com",
      "custom_domain": true,
    },
  ],
  "worker_loaders": [
    {
      "binding": "USER_APPLICATIONS",
    },
    // Bot-authored Package isolates, loaded from the Bot Durable Object with
    // `globalOutbound` disabled (plan Step 4 / decision D2). A separate binding
    // so Bot Packages and user applications never share a loader namespace.
    {
      "binding": "BOT_PACKAGES",
    },
  ],
  // One array: a second "services" key would silently replace this one, and
  // the app would deploy with PACKAGE_BUNDLER unbound.
  "services": [
    // Package bundling runs outside the Durable Object, in a Worker with no
    // outbound bindings of its own (plan Step 3 / decision D4).
    {
      "binding": "PACKAGE_BUNDLER",
      "service": "frockbot-cloudflare-bundler",
    },
    // The shared Computer host (ADR 0004). It holds SPRITES_TOKEN and the
    // Sprites SDK; this Worker sends only an opaque credential reference.
    {
      "binding": "COMPUTER_HOST",
      "service": "frockbot-computer-host",
    },
  ],
  "r2_buckets": [
    {
      "binding": "APPLICATION_ARTIFACTS",
      "bucket_name": "frockbot-application-artifacts",
    },
    {
      "binding": "MEMORY_FILES",
      "bucket_name": "frockbot-memory-files",
    },
    // The remote Package Catalog: immutable generations plus one mutable
    // pointer, published by scripts/publish-catalog.ts and served read-only
    // through /catalog/v1/*.
    {
      "binding": "PACKAGE_CATALOG",
      "bucket_name": "frockbot-package-catalog",
    },
  ],
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "frockbot-auth",
      "database_id": "f83c21a4-e5a0-4cc2-b0e1-636027b8c65e",
      "migrations_dir": "migrations",
    },
  ],
  "vectorize": [
    {
      "binding": "MEMORY_INDEX",
      "index_name": "frockbot-memory",
    },
  ],
  "ai": {
    "binding": "AI",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BOT_STATES",
        "class_name": "BotState",
      },
      {
        "name": "USER_CONFIGURATIONS",
        "class_name": "UserConfiguration",
      },
      {
        "name": "DEPLOYMENT_POLICY",
        "class_name": "DeploymentPolicy",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BotState"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["UserConfiguration"],
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["DeploymentPolicy"],
    },
  ],
  "vars": {
    "DEFAULT_APPLICATION_HASH": "foundation-v1",
    // Comma-separated webview origins allowed to call /api/* cross-origin.
    "ALLOWED_CLIENT_ORIGINS": "capacitor://localhost,frockbot://localhost",
  },
  "env": {
    "development": {
      "worker_loaders": [
        {
          "binding": "USER_APPLICATIONS",
        },
        {
          "binding": "BOT_PACKAGES",
        },
      ],
      "services": [
        {
          "binding": "PACKAGE_BUNDLER",
          "service": "frockbot-cloudflare-bundler",
        },
        {
          "binding": "COMPUTER_HOST",
          "service": "frockbot-computer-host",
        },
      ],
      "r2_buckets": [
        {
          "binding": "APPLICATION_ARTIFACTS",
          "bucket_name": "frockbot-application-artifacts",
          "remote": false,
        },
        {
          "binding": "MEMORY_FILES",
          "bucket_name": "frockbot-memory-files-development",
          "remote": true,
        },
        {
          "binding": "PACKAGE_CATALOG",
          "bucket_name": "frockbot-package-catalog-development",
          "remote": false,
        },
      ],
      "d1_databases": [
        {
          "binding": "AUTH_DB",
          "database_name": "frockbot-auth-development",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations",
          "remote": false,
        },
      ],
      "vectorize": [
        {
          "binding": "MEMORY_INDEX",
          "index_name": "frockbot-memory-development",
          "remote": true,
        },
      ],
      "ai": {
        "binding": "AI",
        "remote": true,
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "BOT_STATES",
            "class_name": "BotState",
          },
          {
            "name": "USER_CONFIGURATIONS",
            "class_name": "UserConfiguration",
          },
          {
            "name": "DEPLOYMENT_POLICY",
            "class_name": "DeploymentPolicy",
          },
        ],
      },
      "vars": {
        "DEFAULT_APPLICATION_HASH": "foundation-v1",
        "ALLOWED_CLIENT_ORIGINS": "capacitor://localhost,frockbot://localhost",
        // Placeholder only. Production supplies this as a secret.
        "FROCKBOT_ADMIN_EMAILS": "owner@example.com",
      },
    },
    // The browser end-to-end harness (`apps/cloudflare/e2e/harness.ts`) runs
    // `src/index.ts` — the deployed Worker, unmodified — under `wrangler dev`.
    // It cannot use `development`: that environment marks `MEMORY_FILES`,
    // `MEMORY_INDEX` and `AI` remote, and a remote binding makes `wrangler dev`
    // open a proxy session against the Cloudflare API, which fails without a
    // `CLOUDFLARE_API_TOKEN` and so cannot run on a pull request.
    //
    // Only binding locality differs. `main`, `compatibility_date`,
    // `compatibility_flags`, `migrations` and the Durable Object classes are
    // the top-level production ones, and every var is the production value.
    // `MEMORY_INDEX` is omitted because workerd has no local Vectorize
    // simulator. `AI` is a local RPC service under this environment: the e2e
    // harness starts its auxiliary Worker in a second local Wrangler process,
    // which the dev service registry connects at the same `run(model, input)`
    // seam without spending account credits or requiring a Cloudflare token.
    "e2e": {
      // This environment is never deployed. Without an empty list it would
      // inherit the top-level custom domain and a stray `wrangler deploy --env
      // e2e` would reassign bot.frockbot.com to it.
      "routes": [],
      "worker_loaders": [
        {
          "binding": "USER_APPLICATIONS",
        },
        {
          "binding": "BOT_PACKAGES",
        },
      ],
      // Declared as production declares them. Neither Worker runs beside the
      // harness, so both report "not connected"; no spec authors a Package or
      // uses a Computer, and a binding that is declared but unreachable is what
      // production looks like when a dependency is down.
      "services": [
        {
          "binding": "PACKAGE_BUNDLER",
          "service": "frockbot-cloudflare-bundler",
        },
        {
          "binding": "COMPUTER_HOST",
          "service": "frockbot-computer-host",
        },
        {
          "binding": "AI",
          "service": "frockbot-workers-ai-e2e",
          "entrypoint": "WorkersAiFake",
        },
      ],
      "r2_buckets": [
        {
          "binding": "APPLICATION_ARTIFACTS",
          "bucket_name": "frockbot-application-artifacts",
          "remote": false,
        },
        {
          "binding": "MEMORY_FILES",
          "bucket_name": "frockbot-memory-files-e2e",
          "remote": false,
        },
        {
          "binding": "PACKAGE_CATALOG",
          "bucket_name": "frockbot-package-catalog",
          "remote": false,
        },
      ],
      "d1_databases": [
        {
          "binding": "AUTH_DB",
          "database_name": "frockbot-auth-e2e",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations",
          "remote": false,
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "BOT_STATES",
            "class_name": "BotState",
          },
          {
            "name": "USER_CONFIGURATIONS",
            "class_name": "UserConfiguration",
          },
          {
            "name": "DEPLOYMENT_POLICY",
            "class_name": "DeploymentPolicy",
          },
        ],
      },
      "vars": {
        "DEFAULT_APPLICATION_HASH": "foundation-v1",
        "ALLOWED_CLIENT_ORIGINS": "capacitor://localhost,frockbot://localhost",
        // The canonical `development` identity is admin in this environment;
        // this placeholder also proves the configured-allowlist rule.
        "FROCKBOT_ADMIN_EMAILS": "owner@example.com",
      },
    },
  },
  "observability": {
    "enabled": true,
  },
}
