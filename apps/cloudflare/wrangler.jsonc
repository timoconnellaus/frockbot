{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "frockbot-cloudflare",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "worker_loaders": [
    {
      "binding": "USER_APPLICATIONS"
    }
  ],
  "r2_buckets": [
    {
      "binding": "APPLICATION_ARTIFACTS",
      "bucket_name": "frockbot-application-artifacts"
    },
    {
      "binding": "MEMORY_FILES",
      "bucket_name": "frockbot-memory-files"
    }
  ],
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "frockbot-auth",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vectorize": [
    {
      "binding": "MEMORY_INDEX",
      "index_name": "frockbot-memory"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BOT_STATES",
        "class_name": "BotState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BotState"]
    }
  ],
  "vars": {
    "DEFAULT_APPLICATION_HASH": "foundation-v1",
    // Comma-separated webview origins allowed to call /api/* cross-origin,
    // e.g. "capacitor://localhost,https://localhost". Empty disables CORS.
    "ALLOWED_CLIENT_ORIGINS": ""
  },
  "observability": {
    "enabled": true
  }
}
