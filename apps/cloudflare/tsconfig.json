{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2023", "WebWorker"],
    "types": ["bun", "@cloudflare/workers-types"]
  },
  "include": ["build-artifact.ts", "dev-electron.ts", "src/**/*.ts"],
  "exclude": ["src/client"]
}
