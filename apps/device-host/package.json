{
  "name": "@frockbot/device-host",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "knip": {
    "entry": [
      "build.ts",
      "src/host.ts",
      "src/runtime.ts",
      "src/**/*.test.ts"
    ],
    "project": [
      "build.ts",
      "src/**/*.ts"
    ]
  },
  "scripts": {
    "build": "bun build.ts",
    "test": "bun test src",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@frockbot/app": "workspace:*",
    "@frockbot/core": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "26.6.2",
    "esbuild": "0.28.2"
  }
}
