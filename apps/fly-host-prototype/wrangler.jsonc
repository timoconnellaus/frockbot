{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "frockbot-computer-host",
  "workers_dev": false,
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "containers": [
    {
      "class_name": "FlyHostContainer",
      "image": "./Dockerfile",
      "max_instances": 3,
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "FLY_HOST",
        "class_name": "FlyHostContainer",
      },
      {
        "name": "COMPUTER_EFFECTS",
        "class_name": "ComputerEffectJournal",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["FlyHostContainer"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ComputerEffectJournal"],
    },
  ],
  "vars": {
    "FLY_HOST_SHARDS": "1",
    "PROTOTYPE_CREDENTIAL_REF": "sprites:computer-host",
  },
}
