{
  // The container half: Node 24, the Plugin SDK's build pipeline, and the
  // tests that drive it.
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2023", "DOM"],
    "types": ["bun", "node"]
  },
  "include": ["./**/*.ts"]
}
