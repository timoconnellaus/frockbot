{
  "name": "@frockbot/applet-build",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "knip": {
    "entry": [
      "src/index.ts",
      "container/server.ts",
      "src/**/*.test.ts",
      "container/**/*.test.ts"
    ],
    "project": [
      "src/**/*.ts",
      "container/**/*.ts"
    ]
  },
  "scripts": {
    "build": "wrangler deploy --dry-run --env=\"\" --outdir dist",
    "container:start": "node container/server.ts",
    "dev": "wrangler dev --port 8792",
    "test": "bun test src container",
    "test:workerd": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p container/tsconfig.json"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "@frockbot/applet-sdk": "workspace:*",
    "@frockbot/applets": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.1",
    "@cloudflare/workers-types": "latest",
    "@types/bun": "1.4.0",
    "@types/node": "26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0",
    "wrangler": "latest"
  }
}
