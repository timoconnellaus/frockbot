// Application-level settings for the Runner target, included by
// `Flutter/Debug.xcconfig` and `Flutter/Release.xcconfig`.

// One app, two identities, as on the Mac (`macos/Runner/Configs/AppInfo.xcconfig`).
// Every build is the released FrockBot unless `FROCKBOT_IOS_DEV=YES` is passed
// to xcodebuild, together with `--dart-define=FROCKBOT_IOS_DEV=true` for the
// Dart half (`lib/client/ios_build.dart`). That build is "FrockBot Dev",
// `com.frockbot.mobile.dev`, with its own `frockbot-dev` sign-in scheme, a
// DEV-ribboned icon and no Firebase registration, so it installs beside the
// released app — whose Shorebird patches a stock build installed over it
// would end — rather than in its place. Each identity is looked up by the
// switch's value; an unset switch selects the empty-suffixed release entries.
FROCKBOT_DISPLAY_NAME_ = FrockBot
FROCKBOT_DISPLAY_NAME_YES = FrockBot Dev
FROCKBOT_BUNDLE_SUFFIX_YES = .dev
FROCKBOT_SCHEME_SUFFIX_YES = -dev
FROCKBOT_APP_ICON_ = AppIcon
FROCKBOT_APP_ICON_YES = AppIconDev

// The name under the icon (Info.plist).
FROCKBOT_DISPLAY_NAME = $(FROCKBOT_DISPLAY_NAME_$(FROCKBOT_IOS_DEV))

// The application's bundle identifier. The release shares the Mac app's.
PRODUCT_BUNDLE_IDENTIFIER = com.frockbot.mobile$(FROCKBOT_BUNDLE_SUFFIX_$(FROCKBOT_IOS_DEV))

// The custom scheme the browser's sign-in and Connect returns hand over on (Info.plist).
FROCKBOT_URL_SCHEME = frockbot$(FROCKBOT_SCHEME_SUFFIX_$(FROCKBOT_IOS_DEV))

// The asset catalog app icon (selected in the Runner target's build settings).
FROCKBOT_APP_ICON = $(FROCKBOT_APP_ICON_$(FROCKBOT_IOS_DEV))

// Push, the associated sign-in domain. Signing itself needs the team's
// profiles, which only Xcode signed in to the team can create
// (apps/native/README.md, "iOS").
CODE_SIGN_ENTITLEMENTS = Runner/Runner.entitlements
DEVELOPMENT_TEAM = Q444L76529
