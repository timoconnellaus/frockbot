{
  "id": "credentials",
  "displayName": "Credential cards",
  "version": "1",
  "contractVersion": 7,
  "tools": [],
  "hooks": [],
  "grants": [],
  "cards": [
    {
      "id": "request",
      "displayName": "Secret request",
      "description": "Ask the person to type a password, card number or other secret into a field on the card. The value goes to their account's credential store and never crosses the conversation; you get a reference to fill it with.",
      "dataSchema": {
        "type": "object",
        "properties": {
          "prompt": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "secretName": { "type": "string", "minLength": 1, "maxLength": 128 },
          "origin": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "payment": { "type": "boolean" }
        },
        "required": ["prompt", "secretName"],
        "additionalProperties": false
      },
      "actions": []
    }
  ],
  "contextKeys": ["user", "bot", "session"]
}
