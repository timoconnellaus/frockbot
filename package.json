{
  "name": "frockbot",
  "version": "0.0.1",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "app",
    "applets",
    "applets/sdk",
    "apps/*",
    "computer",
    "core",
    "frock-compose",
    "providers"
  ],
  "overrides": {
    "file-type": "^21.3.1",
    "uuid": "^11.1.1"
  },
  "scripts": {
    "build:cloudflare": "bun scripts/build-applets-assets.ts && bun run --filter @frockbot/cloudflare build",
    "build:marketing": "bun run --filter @frockbot/marketing build",
    "build:admin-portal": "bun run --filter @frockbot/admin-portal build",
    "bootstrap:npm-trust": "./scripts/bootstrap-npm-trust.sh",
    "dev:phone": "./scripts/phone-dev.sh",
    "dogfood:dev": "./scripts/dogfood/dev-stack.sh",
    "dev:native": "bun scripts/native-dev.ts up",
    "smoke:native": "bun scripts/native-dev.ts smoke",
    "native:release": "python3 scripts/native-update.py release",
    "native:patch": "python3 scripts/native-update.py patch",
    "native:promote": "python3 scripts/native-update.py promote",
    "native:serve": "python3 scripts/native-update.py serve",
    "update:desktop": "python3 scripts/native-desktop-update.py",
    "test:native-update": "python3 scripts/native-update-test.py",
    "dogfood:stop": "./scripts/dogfood/dev-stack.sh stop",
    "dev:cloudflare": "bun run --filter @frockbot/cloudflare dev",
    "dev": "bun run dev:cloudflare",
    "build": "bun run build:cloudflare && bun run build:marketing && bun run build:admin-portal",
    "typecheck": "bun scripts/check-client-protocol.ts && bun scripts/generate-frock-catalog.ts --check && bun scripts/generate-a2ui-skill.ts --check && bun scripts/check-layer-imports.ts && bun scripts/check-computer-host-imports.ts && bun scripts/check-auth-package-imports.ts && bun scripts/generate-isolate-context-catalog.ts --check && bun scripts/generate-card-schema-documents.ts --check && bun scripts/generate-deployment-profile-schema.ts --check && bun scripts/build-applets-assets.ts --check && bun scripts/build-seeded-plugins.ts --check && bun scripts/check-managed-skills.ts && bun scripts/typecheck.ts && bun x tsc --noEmit -p scripts/deployment-config/tsconfig.json",
    "lint:layer-imports": "bun scripts/check-layer-imports.ts",
    "lint:computer-host-imports": "bun scripts/check-computer-host-imports.ts",
    "lint:auth-package-imports": "bun scripts/check-auth-package-imports.ts",
    "setup": "bun scripts/setup.ts",
    "test": "bun test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "generate:protocol": "bun scripts/generate-typescript-protocol.ts && bun scripts/generate-dart-protocol.ts",
    "generate:frock-catalog": "bun scripts/generate-frock-catalog.ts",
    "generate:a2ui-skill": "bun scripts/generate-a2ui-skill.ts",
    "deployment:config": "bun scripts/deployment-config.ts",
    "validate": "bun scripts/validate.ts",
    "validate:unit": "bun scripts/validate.ts unit",
    "validate:integration": "bun scripts/validate.ts integration",
    "validate:runtime": "bun scripts/validate.ts runtime",
    "validate:e2e": "bun scripts/validate.ts e2e",
    "validate:typecheck": "bun scripts/validate.ts typecheck",
    "validate:format": "bun scripts/validate.ts format",
    "validate:build": "bun scripts/validate.ts build",
    "eval:greeting": "bun scripts/eval-greeting.ts",
    "eval:conversation": "bun scripts/eval-conversation.ts",
    "eval:turn-start": "bun scripts/eval-turn-start.ts",
    "eval:response-review": "bun scripts/eval-response-review.ts",
    "eval:call-review": "bun scripts/eval-call-review.ts",
    "eval:routine-event": "bun scripts/eval-routine-event.ts",
    "eval:dictation-cleanup": "bun scripts/eval-dictation-cleanup.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "husky": "^9.1.7",
    "json-schema-to-ts": "^3.1.1",
    "lint-staged": "^17.5.1",
    "playwright": "1.63.0",
    "prettier": "^3.9.7",
    "prettier-plugin-sh": "^0.19.0",
    "typescript": "npm:typescript-native-bridge@6.0.3-bridge.16.tsgo.7.0.2"
  },
  "patchedDependencies": {
    "wrangler@4.129.0": "patches/wrangler@4.129.0.patch"
  }
}
