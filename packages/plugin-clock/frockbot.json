{
  "schemaVersion": 3,
  "id": "clock",
  "displayName": "Clock",
  "version": "0.0.1",
  "compatibility": { "frockbot": ">=0.0.1" },
  "dependencies": { "shell": ">=0.0.1", "ui-theme": ">=0.0.1" },
  "contributions": {
    "runtime": { "entry": "./agent" },
    "desktop": {
      "entry": "./host",
      "execution": "trusted-main",
      "commands": []
    },
    "client": {
      "entry": "./client",
      "mounts": [{ "slot": "frockbot.right-panel" }],
      "outlets": []
    }
  },
  "permissions": ["time:read"]
}
