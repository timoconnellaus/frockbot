{
  "schemaVersion": 4,
  "id": "audit",
  "displayName": "Audit",
  "version": "0.0.1",
  "compatibility": {
    "frockbot": ">=0.0.1"
  },
  "dependencies": {
    "flock": ">=0.0.1",
    "shell": ">=0.0.1",
    "ui-theme": ">=0.0.1"
  },
  "contributions": {
    "backend": [
      {
        "entry": "./user",
        "host": "user"
