{
  "schemaVersion": 3,
  "id": "computer",
  "displayName": "Computer",
  "version": "0.0.1",
  "compatibility": { "frockbot": ">=0.0.1" },
  "dependencies": { "shell": ">=0.0.1", "ui-theme": ">=0.0.1" },
  "contributions": {
    "runtime": { "entry": "./agent" },
    "client": {
      "entry": "./client",
      "mounts": [{ "slot": "frockbot.computer" }],
      "outlets": []
    }
  },
  "permissions": ["computer:execute", "computer:browser", "webui:remote-frame"]
}
