{
  "schemaVersion": 4,
  "id": "shell",
  "displayName": "FrockBot Shell",
  "version": "0.0.1",
  "compatibility": {
    "frockbot": ">=0.0.1"
  },
  "dependencies": {
    "ui-theme": ">=0.0.1"
  },
  "contributions": {
    "backend": [
      {
        "entry": "./backend",
        "host": "bot"
      }
    ],
    "runtime": {
      "entry": "./agent"
    },
    "client": {
      "entry": "./client",
      "mounts": [
        {
          "slot": "authenticated-root",
          "order": 10000
        }
      ],
      "outlets": [
        "frockbot.right-panel",
        "frockbot.computer",
        "frockbot.sidebar-bots",
        "frockbot.sidebar-actions",
        "frockbot.user-profile",
        "frockbot.bot-actions",
        "frockbot.overlays",
        "frockbot.bot-identity"
      ]
    }
  },
  "permissions": ["agent:turn"],
  "configuration": {
    "settings": [],
    "connectionTypes": [],
    "capabilities": [
      {
        "id": "user-voice",
        "kind": "tool",
        "connectionTypes": [],
        "admission": {
          "turnTypes": ["chat"]
        }
      },
      {
        "id": "parent-handoff",
        "kind": "tool",
        "connectionTypes": [],
        "admission": {
          "turnTypes": ["automation", "subagent"]
        }
      }
    ]
  }
}
