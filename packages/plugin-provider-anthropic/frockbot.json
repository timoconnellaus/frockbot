{
  "schemaVersion": 4,
  "id": "provider-anthropic",
  "displayName": "Anthropic",
  "version": "0.0.1",
  "compatibility": {
    "frockbot": ">=0.0.1"
  },
  "dependencies": {
    "credentials": ">=0.0.1",
    "settings": ">=0.0.1"
  },
  "defaultEnablement": "disabled",
  "contributions": {
    "runtime": {
      "entry": "./runtime"
    }
  },
  "permissions": ["connections:manage", "models:invoke", "network:anthropic"],
  "configuration": {
    "connectionTypes": [
      {
        "id": "anthropic-account",
        "displayName": "Anthropic account",
        "allowMultiple": true,
        "authorization": {
          "kind": "api-key",
          "driverId": "anthropic"
        },
        "capabilities": ["anthropic-models"],
        "settings": [
          {
            "id": "api-base-url",
            "schemaVersion": 1,
            "schema": {
              "type": "string",
              "title": "API base URL",
              "description": "Root URL of the Anthropic Messages API, without a trailing slash. Absent means https://api.anthropic.com/v1.",
              "minLength": 1,
              "maxLength": 2048
            }
          }
        ]
      }
    ],
    "capabilities": [
      {
        "id": "anthropic-models",
        "kind": "model",
        "connectionTypes": ["anthropic-account"],
        "admission": {
          "turnTypes": ["chat", "automation", "subagent"]
        }
      }
    ]
  }
}
