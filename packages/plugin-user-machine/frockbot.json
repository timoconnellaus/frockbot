{
  "schemaVersion": 4,
  "id": "user-machine",
  "displayName": "Registered machines",
  "version": "0.0.1",
  "compatibility": {
    "frockbot": ">=0.0.1"
  },
  "dependencies": {
    "shell": ">=0.0.1",
    "ui-theme": ">=0.0.1"
  },
  "contributions": {
    "backend": [
      {
        "entry": "./user",
        "host": "user"
      },
      {
        "entry": "./backend",
        "host": "gateway"
      }
    ],
    "runtime": {
      "entry": "./agent"
    },
    "client": {
      "entry": "./client",
      "mounts": [
        {
          "slot": "frockbot.user-settings-sections",
          "order": 30
        }
      ],
      "outlets": []
    },
    "desktop": {
      "entry": "./desktop",
      "execution": "trusted-main",
      "commands": []
    }
  },
  "configuration": {
    "settings": [],
    "connectionTypes": [],
    "capabilities": [
      {
        "id": "machine-registry",
        "kind": "tool",
        "connectionTypes": [],
        "admission": {
          "turnTypes": ["chat", "automation", "subagent"]
        }
      },
      {
        "id": "machine-control",
        "kind": "tool",
        "connectionTypes": [],
        "admission": {
          "turnTypes": ["chat"]
        }
      }
    ]
  },
  "permissions": []
}
