{
  "name": "@frockbot/compose-typescript",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Type-check and transpile FrockBot Compose plugin source against its granted stubs.",
  "license": "MIT",
  "bin": {
    "frockbot-compose-declarations": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./generate": "./src/generate.ts",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "test": "bun test tests",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@frockbot/compose-core": "workspace:*",
    "typescript": "6.0.2"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/node": "26.4.0",
    "rolldown": "^1.2.6",
    "vite": "8.2.2"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timoconnellaus/frockbot.git",
    "directory": "packages/compose-typescript"
  }
}
