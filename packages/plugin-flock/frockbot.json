{
  "schemaVersion": 4,
  "id": "flock",
  "displayName": "Flock",
  "version": "0.0.1",
  "compatibility": { "frockbot": ">=0.0.1" },
  "dependencies": {
    "shell": ">=0.0.1",
    "ui-theme": ">=0.0.1"
  },
  "contributions": {
    "backend": [
      { "entry": "./backend", "host": "gateway" },
      { "entry": "./user", "host": "user" },
      { "entry": "./bot", "host": "bot" }
    ],
    "runtime": { "entry": "./agent" },
    "client": {
      "entry": "./client",
      "mounts": [
        { "slot": "frockbot.sidebar-bots", "order": 10 },
        { "slot": "frockbot.overlays", "order": 10 },
        { "slot": "frockbot.bot-identity", "order": 10 },
        { "slot": "frockbot.bot-avatar", "order": 10 },
        { "slot": "frockbot.bot-avatar-editor", "order": 10 },
        { "slot": "frockbot.bot-settings-primary-sections", "order": 900 }
      ],
      "outlets": []
    }
  },
  "permissions": ["bot:self-manage"],
  "configuration": {
    "settings": [],
    "connectionTypes": [],
    "capabilities": [
      { "id": "bot-self-management", "kind": "tool", "connectionTypes": [] },
      {
        "id": "bot-messaging",
        "kind": "tool",
        "connectionTypes": [],
        "admission": { "turnTypes": ["chat"] }
      }
    ]
  }
}
