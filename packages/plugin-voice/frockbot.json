{
  "schemaVersion": 4,
  "id": "voice",
  "displayName": "Voice",
  "version": "0.0.1",
  "compatibility": { "frockbot": ">=0.0.1" },
  "dependencies": {
    "flock": ">=0.0.1",
    "memory": ">=0.0.1",
    "shell": ">=0.0.1",
    "ui-theme": ">=0.0.1"
  },
  "contributions": {
    "backend": [
      { "entry": "./user", "host": "user" },
      { "entry": "./backend", "host": "gateway" }
    ],
    "client": {
      "entry": "./client",
      "mounts": [{ "slot": "frockbot.header-actions", "order": 20 }],
      "outlets": []
    }
  },
  "permissions": []
}
