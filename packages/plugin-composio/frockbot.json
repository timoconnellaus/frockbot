{
  "schemaVersion": 4,
  "id": "composio",
  "displayName": "Connected apps",
  "version": "0.0.1",
  "compatibility": {
    "frockbot": ">=0.0.1"
  },
  "contributions": {
    "backend": [
      {
        "entry": "./backend",
        "host": "gateway"
      },
      {
        "entry": "./user-configuration",
        "host": "user"
      }
    ]
  },
  "permissions": ["connections:manage", "tools:execute"],
  "configuration": {
    "settings": [],
    "connectionTypes": [
      {
        "id": "app",
        "displayName": "Connected apps",
        "catalogPath": "/api/plugins/composio/catalog",
        "allowMultiple": true,
        "authorization": {
          "kind": "grant",
          "driverId": "composio"
        },
        "capabilities": []
      }
    ],
    "capabilities": []
  }
}
