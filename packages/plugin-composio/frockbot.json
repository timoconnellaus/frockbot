{
  "schemaVersion": 4,
  "id": "composio",
  "displayName": "Connected apps",
  "version": "0.0.1",
  "compatibility": {
    "frockbot": ">=0.0.1"
  },
  "contributions": {
    "backend": [
      {
        "entry": "./backend",
        "host": "gateway"
      },
      {
        "entry": "./user-configuration",
        "host": "user"
      }
    ],
    "runtime": {
      "entry": "./agent"
    }
  },
  "permissions": ["connections:manage", "tools:execute"],
  "configuration": {
    "settings": [],
    "connectionTypes": [
      {
        "id": "app",
        "displayName": "Connected apps",
        "catalogPath": "/api/plugins/composio/catalog",
        "allowMultiple": true,
        "authorization": {
          "kind": "grant",
          "driverId": "composio"
        },
        "capabilities": ["app-tools"]
      }
    ],
    "capabilities": [
      {
        "id": "app-tools",
        "kind": "tool",
        "connectionTypes": ["app"],
        "admission": {
          "turnTypes": ["chat", "automation", "subagent"],
          "subagentRoles": ["executor"]
        }
      }
    ]
  }
}
