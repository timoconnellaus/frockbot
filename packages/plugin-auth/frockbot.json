{
  "schemaVersion": 3,
  "id": "auth",
  "displayName": "Authentication",
  "version": "0.0.1",
  "compatibility": { "frockbot": ">=0.0.1" },
  "dependencies": { "ui-theme": ">=0.0.1" },
  "contributions": {
    "client": {
      "entry": "./client",
      "mounts": [{ "slot": "root", "order": 20000 }],
      "outlets": ["authenticated-root"]
    },
    "desktop": {
      "entry": "./desktop",
      "execution": "trusted-main",
      "commands": []
    }
  },
  "permissions": ["identity:authenticate"]
}
