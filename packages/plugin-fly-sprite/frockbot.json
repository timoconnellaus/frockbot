{
  "schemaVersion": 1,
  "id": "fly-sprite",
  "displayName": "Fly Sprite Computer",
  "version": "0.0.1",
  "contributions": {
    "agent": "./agent",
    "desktop": "./host",
    "web": {
      "entry": "./client",
      "manifest": "./dist/manifest.json",
      "slots": ["frockbot.computer"]
    }
  },
  "permissions": [
    "computer:execute",
    "computer:browser",
    "network:sprites",
    "webui:remote-frame"
  ]
}
