    "test": "bun test test spike",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@tanstack/db": "0.8.7",
    "@tanstack/react-db": "0.3.7",
    "esbuild": "0.28.2",
    "eslint": "10.9.1",
    "miniflare": "5.20260828.0-alpha",
    "typescript": "7.0.2",
    "typescript-eslint": "8.69.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
