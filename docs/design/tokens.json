  "elevation": {
    "raised": "inset 0 1px 0 highlight",
    "floating": "0 12px 40px rgb(0 0 0 / 40%)",
    "sheet": "0 -20px 60px rgb(0 0 0 / 50%)",
    "phone": "0 30px 80px rgb(0 0 0 / 55%)"
  },
  "motion": {
    "curve": [0.2, 0, 0, 1],
    "fast": 140,
    "enter": 260,
    "pulse": 1600
