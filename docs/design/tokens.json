  "icon": { "strokeText": 1.6, "strokeControl": 1.75, "baselineNudge": -0.5 },
  "rules": [
    "One pink pill per screen; it carries the glow.",
    "One glow per screen, behind what is working or what needs you.",
    "Rows inside a group have no gap; hairlines start at the text edge.",
    "Nothing under 20px is heavier than 600.",
    "Archivo Black only for greetings, Bot names and stat numbers; never in a control.",
    "Messages are text.message; the composer is the same size.",
    "Destructive actions are ink in danger on a tile, never a red fill.",
    "Numbers are tabular; money has two decimals and a symbol.",
    "Disabled is the whole control at 40% opacity.",
    "Hover does not exist on touch; pressed darkens one step for the duration of the touch."
  ]
}
