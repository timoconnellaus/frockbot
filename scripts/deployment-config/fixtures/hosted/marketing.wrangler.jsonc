{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "frockbot-marketing",
  "account_id": "374784ce2915a597adcecf9bcb2c5ee6",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "frockbot.com",
      "custom_domain": true,
    },
    {
      "pattern": "www.frockbot.com",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true,
  },
  "observability": {
    "enabled": true,
  },
}
