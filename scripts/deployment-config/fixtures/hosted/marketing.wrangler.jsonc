{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "frockbot-marketing",
  "account_id": "374784ce2915a597adcecf9bcb2c5ee6",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-27",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "frockbot.com",
      "custom_domain": true,
    },
    {
      "pattern": "www.frockbot.com",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true,
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "DEPLOY_ACCOUNTS",
        "class_name": "DeployAccount",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DeployAccount"],
    },
  ],
  "limits": {
    "cpu_ms": 300000,
  },
  "observability": {
    "enabled": true,
  },
}
