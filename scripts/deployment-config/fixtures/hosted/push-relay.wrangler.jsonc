{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "frockbot-push-relay",
  "account_id": "374784ce2915a597adcecf9bcb2c5ee6",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  // The relay's one door is its hostname.
  "workers_dev": false,
  "routes": [
    {
      "pattern": "push.frockbot.com",
      "custom_domain": true,
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "RELAY", "class_name": "RelayObject" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RelayObject"] }],
  "observability": {
    "enabled": true,
  },
}
