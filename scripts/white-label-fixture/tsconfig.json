{
  // The consumer's own typecheck, run by `scripts/white-label-fixture.ts` once
  // the tarballs are installed: its choosers and brand against the published
  // contract, with no shim. `payments/prove.ts` is run by Bun, not compiled. In this repository nothing resolves
  // `@frockbot/core` from here, so nothing else reads this file.
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "lib": ["ES2023", "WebWorker"],
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["auth/chooser.ts", "payments/chooser.ts", "brand/brand.ts"]
}
