{
  "name": "@frockbot/frock-compose",
  "version": "0.0.1",
  "private": false,
  "license": "MIT",
  "type": "module",
  "description": "The FrockBot Plugin worker host: loads a User's Plugins as one Dynamic Worker behind a generated index.",
  "exports": {
    ".": "./index.ts",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@frockbot/core": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "^7.0.2"
  },
  "files": [
    "**/*.ts",
    "README.md",
    "!**/*.test.ts",
    "!**/*.type-test.ts",
    "!**/tsconfig*.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timoconnellaus/frockbot.git",
    "directory": "frock-compose"
  },
  "frockbot": {
    "npm": true
  }
}
